// MVP schema. Source of truth: docs/03-database.md §3
// JSON columns (draftContent, draftDesign, published*) are validated with Zod in src/lib/invitation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled in production
  directUrl = env("DATABASE_URL_UNPOOLED") // used by migrations
}

// ───────────── Auth.js ─────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(USER)
  suspendedAt   DateTime? // admin suspended: can't sign in; published sites stay up unless taken down
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  invitations      Invitation[]
  mediaAssets      MediaAsset[]
  entitlements     Entitlement[]
  adminPermissions AdminPermission[]
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

/// Opens per invitation per day (UTC), counted by the open beacon. Counts only, no personal data.
model InvitationDailyStat {
  invitationId String
  date         DateTime @db.Date
  opens        Int      @default(0) // every open (public link + guest links)
  guestOpens   Int      @default(0) // opens through a personal guest link

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@id([invitationId, date])
  @@index([date])
}

// ───────────── Music library (docs/19 §4.6) ─────────────

/// A song couples can pick for any template. Stored in /public (STATIC) or uploaded by an admin.
model MusicTrack {
  id          String        @id // stable id stored in invitations (e.g. "krishna-flute")
  title       String
  artist      String?
  mood        String        @default("")
  url         String
  provider    MusicProvider @default(STATIC)
  publicId    String? // storage key for uploaded tracks
  durationSec Int           @default(0)
  licence     MusicLicence  @default(UNLICENSED)
  licenceNote String?
  isActive    Boolean       @default(true) // shown in the editor's picker
  replacedBy  String? // retired: invitations using it play this track instead
  sortOrder   Int           @default(0)
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, sortOrder])
}

enum MusicProvider {
  STATIC
  LOCAL
  CLOUDINARY
}

enum MusicLicence {
  OWNED
  LICENSED
  ROYALTY_FREE
  UNLICENSED
}

/// An admin's replacement for one of a template's art files (served via /t-art/<slug>/<file>).
model TemplateAssetOverride {
  templateSlug String
  file         String // e.g. "ghats.webp" (the file name in public/templates/<slug>/art/)
  url          String
  provider     MusicProvider
  publicId     String
  width        Int?
  height       Int?
  licence      MusicLicence  @default(UNLICENSED)
  updatedBy    String
  updatedAt    DateTime      @updatedAt

  @@id([templateSlug, file])
}

// ───────────── Admin (docs/19-admin-panel.md) ─────────────

/// A permission a Superadmin set for one Admin; overrides the catalogue default (src/lib/admin/permissions.ts).
model AdminPermission {
  userId    String
  key       String
  allowed   Boolean
  grantedBy String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

/// Every admin write (and every personal-data reveal). Append-only.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────── Catalogue ─────────────

model Template {
  id             String           @id @default(cuid())
  slug           String           @unique // matches src/templates/<slug>
  name           String
  tagline        String?
  category       TemplateCategory
  tags           String[]
  tier           TemplateTier     @default(FREE)
  pricePaise     Int? // future
  isActive       Boolean          @default(true)
  defaultTrackId String? // admin override of the manifest's defaultMusicTrackId
  retiredAt      DateTime? // admin retired it: hidden everywhere, not choosable; existing invitations keep rendering
  isNew          Boolean          @default(false)
  sortOrder      Int              @default(0)
  version        Int              @default(1)
  posterUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  invitations Invitation[]

  @@index([isActive, sortOrder])
}

enum TemplateCategory {
  ROYAL
  MINIMAL
  FLORAL
  CINEMATIC
  MODERN
}

enum TemplateTier {
  FREE
  PREMIUM
}

// ───────────── Invitations ─────────────

model Invitation {
  id           String           @id @default(cuid())
  ownerId      String
  templateSlug String // current (draft) template
  slug         String           @unique
  title        String           @db.VarChar(120)
  status       InvitationStatus @default(DRAFT)

  contentSchemaVersion Int      @default(1)
  draftContent         Json
  draftDesign          Json
  draftUpdatedAt       DateTime @default(now())

  publishedTemplateSlug String?
  publishedContent      Json?
  publishedDesign       Json?
  publishedVersion      Int       @default(0)
  publishedAt           DateTime?
  unpublishedAt         DateTime?

  archivedAt     DateTime?
  disabledAt     DateTime? // platform takedown
  disabledReason String?

  weddingDate   DateTime? @db.Date // denormalized for list/sort
  coverImageUrl String? // denormalized for list cards
  openCount     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template    Template              @relation(fields: [templateSlug], references: [slug])
  guests      Guest[]
  mediaAssets MediaAsset[]
  dailyStats  InvitationDailyStat[]

  @@index([ownerId, status, updatedAt(sort: Desc)])
  @@index([slug, status])
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ───────────── Guests ─────────────

model Guest {
  id           String      @id @default(cuid())
  invitationId String
  displayName  String      @db.VarChar(80)
  greeting     String?     @db.VarChar(120)
  personalNote String?     @db.VarChar(500)
  notes        String?     @db.VarChar(500) // owner-only, NEVER rendered
  phone        String?     @db.VarChar(20) // owner-only
  eventAccess  EventAccess @default(ALL)
  eventIds     String[]

  token          String   @unique // 22-char base64url, 128-bit random
  tokenCreatedAt DateTime @default(now())

  status        GuestStatus @default(NOT_SHARED)
  sharedAt      DateTime?
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  openCount     Int         @default(0)

  rsvp Json? // RESERVED for future RSVP; unused in MVP

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation    Invitation          @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  revokedTokens RevokedGuestToken[]

  @@index([invitationId, createdAt(sort: Desc)])
}

enum EventAccess {
  ALL
  SELECTED
}

enum GuestStatus {
  NOT_SHARED
  SHARED
  OPENED
}

/// Old tokens after "Regenerate link".
model RevokedGuestToken {
  token     String   @id
  guestId   String
  revokedAt DateTime @default(now())
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
}

// ───────────── Media ─────────────

model MediaAsset {
  id           String        @id @default(cuid())
  ownerId      String
  invitationId String?
  kind         MediaKind
  role         MediaRole?
  provider     MediaProvider @default(CLOUDINARY)
  publicId     String
  url          String
  mimeType     String?
  bytes        Int?
  width        Int?
  height       Int?
  durationSec  Float?
  alt          String?       @db.VarChar(200)
  focalX       Float?
  focalY       Float?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@unique([provider, publicId])
  @@index([invitationId])
  @@index([ownerId])
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaRole {
  COUPLE
  FAMILY
  GALLERY
  BACKGROUND
  VIDEO
  MUSIC
  OTHER
}

enum MediaProvider {
  CLOUDINARY
  S3
  LOCAL // development only
}

// ───────────── Payment-ready seam (docs/17-future-payments.md) ─────────────

model Entitlement {
  id           String            @id @default(cuid())
  userId       String
  type         EntitlementType
  templateSlug String?
  invitationId String?
  feature      String?
  source       EntitlementSource
  orderId      String? // FK added when Order exists
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum EntitlementType {
  TEMPLATE
  INVITATION_PUBLISH
  FEATURE
}

enum EntitlementSource {
  FREE_LAUNCH
  ORDER
  ADMIN_GRANT
}
