// Vivah Studio — MVP schema. Source of truth: docs/03-database.md §3
// JSON columns (draftContent, draftDesign, published*) are validated with Zod in src/lib/invitation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled in production
  directUrl = env("DATABASE_URL_UNPOOLED") // used by migrations
}

// ───────────── Auth.js ─────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(USER)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  invitations  Invitation[]
  mediaAssets  MediaAsset[]
  entitlements Entitlement[]
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────── Catalogue ─────────────

model Template {
  id         String           @id @default(cuid())
  slug       String           @unique // matches src/templates/<slug>
  name       String
  tagline    String?
  category   TemplateCategory
  tags       String[]
  tier       TemplateTier     @default(FREE)
  pricePaise Int? // future
  isActive   Boolean          @default(true)
  isNew      Boolean          @default(false)
  sortOrder  Int              @default(0)
  version    Int              @default(1)
  posterUrl  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  invitations Invitation[]

  @@index([isActive, sortOrder])
}

enum TemplateCategory {
  ROYAL
  MINIMAL
  FLORAL
  CINEMATIC
  MODERN
}

enum TemplateTier {
  FREE
  PREMIUM
}

// ───────────── Invitations ─────────────

model Invitation {
  id           String           @id @default(cuid())
  ownerId      String
  templateSlug String // current (draft) template
  slug         String           @unique
  title        String           @db.VarChar(120)
  status       InvitationStatus @default(DRAFT)

  contentSchemaVersion Int      @default(1)
  draftContent         Json
  draftDesign          Json
  draftUpdatedAt       DateTime @default(now())

  publishedTemplateSlug String?
  publishedContent      Json?
  publishedDesign       Json?
  publishedVersion      Int       @default(0)
  publishedAt           DateTime?
  unpublishedAt         DateTime?

  archivedAt     DateTime?
  disabledAt     DateTime? // platform takedown
  disabledReason String?

  weddingDate   DateTime? @db.Date // denormalized for list/sort
  coverImageUrl String? // denormalized for list cards
  openCount     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template    Template     @relation(fields: [templateSlug], references: [slug])
  guests      Guest[]
  mediaAssets MediaAsset[]

  @@index([ownerId, status, updatedAt(sort: Desc)])
  @@index([slug, status])
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ───────────── Guests ─────────────

model Guest {
  id           String      @id @default(cuid())
  invitationId String
  displayName  String      @db.VarChar(80)
  greeting     String?     @db.VarChar(120)
  personalNote String?     @db.VarChar(500)
  notes        String?     @db.VarChar(500) // owner-only, NEVER rendered
  phone        String?     @db.VarChar(20) // owner-only
  eventAccess  EventAccess @default(ALL)
  eventIds     String[]

  token          String   @unique // 22-char base64url, 128-bit random
  tokenCreatedAt DateTime @default(now())

  status        GuestStatus @default(NOT_SHARED)
  sharedAt      DateTime?
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  openCount     Int         @default(0)

  rsvp Json? // RESERVED for future RSVP; unused in MVP

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation    Invitation          @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  revokedTokens RevokedGuestToken[]

  @@index([invitationId, createdAt(sort: Desc)])
}

enum EventAccess {
  ALL
  SELECTED
}

enum GuestStatus {
  NOT_SHARED
  SHARED
  OPENED
}

/// Old tokens after "Regenerate link".
model RevokedGuestToken {
  token     String   @id
  guestId   String
  revokedAt DateTime @default(now())
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
}

// ───────────── Media ─────────────

model MediaAsset {
  id           String        @id @default(cuid())
  ownerId      String
  invitationId String?
  kind         MediaKind
  role         MediaRole?
  provider     MediaProvider @default(CLOUDINARY)
  publicId     String
  url          String
  mimeType     String?
  bytes        Int?
  width        Int?
  height       Int?
  durationSec  Float?
  alt          String?       @db.VarChar(200)
  focalX       Float?
  focalY       Float?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@unique([provider, publicId])
  @@index([invitationId])
  @@index([ownerId])
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaRole {
  COUPLE
  FAMILY
  GALLERY
  BACKGROUND
  VIDEO
  MUSIC
  OTHER
}

enum MediaProvider {
  CLOUDINARY
  S3
  LOCAL // development only
}

// ───────────── Payment-ready seam (docs/17-future-payments.md) ─────────────

model Entitlement {
  id           String            @id @default(cuid())
  userId       String
  type         EntitlementType
  templateSlug String?
  invitationId String?
  feature      String?
  source       EntitlementSource
  orderId      String? // FK added when Order exists
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum EntitlementType {
  TEMPLATE
  INVITATION_PUBLISH
  FEATURE
}

enum EntitlementSource {
  FREE_LAUNCH
  ORDER
  ADMIN_GRANT
}
