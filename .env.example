# ── App ──
# Product name shown everywhere (logo, titles, emails, previews). Read at build time; redeploy after changing.
NEXT_PUBLIC_BRAND_NAME="Invitation Banao"
NEXT_PUBLIC_APP_URL=http://localhost:3000
LAUNCH_ALL_FREE=true

# ── Database (local Postgres or Neon) ──
DATABASE_URL=postgresql://USER@localhost:5432/vivah_dev
DATABASE_URL_UNPOOLED=postgresql://USER@localhost:5432/vivah_dev

# ── Auth.js ──  (generate AUTH_SECRET with: openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
EMAIL_FROM="Invitation Banao <onboarding@resend.dev>"

# ── Media (Phase 3) ──
# Without Cloudinary keys, development stores uploads in .data/uploads (never in production).
# MEDIA_PROVIDER=local|cloudinary  (optional override)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Upstash (Phase 5) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Marketing site (Phase 6) ──
# WhatsApp business number, digits with country code (e.g. 919876543210). Chip/links hidden when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
# Contact form deliveries go here via Resend (AUTH_RESEND_KEY). Dev without a key: printed to the console.
# CONTACT_INBOX=   (listed below)

# ── Ops (Phase 7) ──
# Error tracking. Server DSN + browser DSN (same value). Source maps upload only when the token is set.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" (generate: openssl rand -hex 32)
CRON_SECRET=
# 1 = ship CSP as report-only (rollout week on preview), unset = enforce
CSP_REPORT_ONLY=
CONTACT_INBOX=
